# Estas variables van en Vercel → Project Settings → Environment Variables del proyecto
# vakoclub.com (los endpoints viven en api/printify/, mismo proyecto que el resto del sitio).
PRINTIFY_TOKEN=your_printify_token_here
PRINTIFY_SHOP_ID=123456
HOST_FORWARD_SECRET=some-random-secret-string

# Opcional pero recomendado: secreto del webhook configurado en Printify → Shop settings →
# Webhooks. Sin esto, api/printify/webhook.js acepta eventos sin verificar su firma.
PRINTIFY_WEBHOOK_SECRET=another-random-secret-string
