{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(api|.*\\.[^/]+)$", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/download-guide.js": {
      "includeFiles": "private/**"
    }
  }
}
