# Estas variables van en Vercel → Project Settings → Environment Variables del proyecto
# vakoclub.com (los endpoints viven en api/printify/, mismo proyecto que el resto del sitio).
PRINTIFY_TOKEN=your_printify_token_here
PRINTIFY_SHOP_ID=123456
HOST_FORWARD_SECRET=some-random-secret-string

# Opcional pero recomendado: secreto del webhook configurado en Printify → Shop settings →
# Webhooks. Sin esto, api/printify/webhook.js acepta eventos sin verificar su firma.
PRINTIFY_WEBHOOK_SECRET=another-random-secret-string

# api/printify/sync-orders.js — trae pedidos pagados de Hostinger Ecommerce y los manda a Printify.
# HOSTINGER_API_TOKEN ya debería existir en Vercel (lo usa api/subscribe-lead.js para Reach).
# CRON_SECRET: Vercel lo manda solo en el header Authorization al disparar el cron diario
# (vercel.json → crons). PRINTIFY_SYNC_SECRET es para dispararlo a mano o desde afuera si hace
# falta más frecuencia que 1 vez/día (límite del plan Hobby).
CRON_SECRET=yet-another-random-secret-string
PRINTIFY_SYNC_SECRET=yet-another-different-random-secret-string
