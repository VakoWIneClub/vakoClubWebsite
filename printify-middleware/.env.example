# .env.example - añade estas variables en Vercel (Project → Settings → Environment Variables)
PRINTIFY_TOKEN=your_printify_token_here
PRINTIFY_SHOP_ID=123456
HOST_FORWARD_SECRET=some-random-secret-string

# Opcional: si necesitas persistencia, configura una DB (Supabase/Postgres) y añade URL/credentials aquí
# DATABASE_URL=postgres://user:pass@host:5432/dbname
